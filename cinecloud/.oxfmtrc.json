{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 80,
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    ".output/",
    "src/routeTree.gen.ts",
    "components.json",
    "*.log",
    ".env",
    ".env.local",
    ".env.production",
    ".vscode/",
    ".DS_Store",
    "Thumbs.db"
  ]
}
