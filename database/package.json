{
  "name": "cinecloud-db",
  "type": "module",
  "scripts": {
    "setup": "bun run src/setup.ts",
    "seed": "bun run src/seed.ts",
    "teardown": "bun run src/teardown.ts",
    "reset": "bun run src/teardown.ts && bun run src/setup.ts && bun run src/seed.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.712.0",
    "@aws-sdk/lib-dynamodb": "^3.712.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bun": "^1.1.14",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  }
}
