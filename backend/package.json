{
  "name": "cinecloud-backend",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "build:lambda": "sam build",
    "deploy": "sam deploy",
    "deploy:staging": "sam deploy --config-env staging",
    "deploy:prod": "sam deploy --config-env prod",
    "local:api": "sam local start-api --warm-containers EAGER",
    "local:invoke": "sam local invoke CineCloudFunction",
    "validate": "sam validate --lint"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.712.0",
    "@aws-sdk/lib-dynamodb": "^3.712.0",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/bun": "^1.1.14",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  }
}
