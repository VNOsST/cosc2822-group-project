# AWS Cognito Configuration
# Copy this file to .env and fill in your values

# AWS Region where your Cognito User Pool is located (e.g., us-east-1, ap-southeast-1)
VITE_AWS_REGION=your-aws-region

# Your Cognito User Pool ID (e.g., us-east-1_XXXXXXXXX)
VITE_AWS_USER_POOL_ID=your-user-pool-id

# Your Cognito User Pool Client ID (App Client ID)
VITE_AWS_USER_POOL_CLIENT_ID=your-client-id

